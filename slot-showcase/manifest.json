{
  "id": "slot-showcase",
  "name": "Slot showcase",
  "version": "1.1.0",
  "minAppVersion": "1.15.0",
  "author": "Bulwark Mail Community",
  "description": "For plugin authors and tests, not for everyday use. Draws every plugin slot with the app's UI kit component meant for it, and a button on every action surface, so you can see where each one sits and what it receives.",
  "type": "ui-extension",
  "permissions": [
    "ui:observe",
    "ui:toolbar",
    "ui:app-top-banner",
    "ui:email-banner",
    "ui:email-footer",
    "ui:contact-cryptokeys",
    "ui:email-details",
    "ui:download-file",
    "ui:notifications",
    "ui:message-list-tabs",
    "ui:composer-toolbar",
    "ui:composer-sidebar",
    "ui:sidebar-widget",
    "ui:settings-section",
    "ui:context-menu",
    "ui:navigation-rail",
    "ui:keyboard",
    "ui:calendar-action",
    "ui:admin-page",
    "ui:message-list",
    "ui:contacts",
    "ui:tasks",
    "ui:files",
    "ui:commands",
    "ui:app-page",
    "account:read",
    "email:read",
    "email:send",
    "compose:open",
    "calendar:read",
    "contacts:read",
    "tasks:read",
    "files:read"
  ],
  "entrypoint": "index.js"
}
